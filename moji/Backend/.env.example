# Cấu hình cổng chạy backend
PORT=5001

# URL của Frontend (GitHub Pages hoặc Localhost)
CLIENT_URL=http://localhost:5500

# Chuỗi kết nối MongoDB Atlas (Thay <username> và <password> bằng tài khoản của bạn)
MONGODB_CONNECTIONSTRING=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/happi_chat?retryWrites=true&w=majority

# Chuỗi bí mật mã hóa JWT Token
